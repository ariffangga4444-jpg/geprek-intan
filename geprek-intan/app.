@app.route("/admin/status/<int:id>/<string:status_baru>")
def ubah_status(id, status_baru):
    db = get_db()
    db.execute(
        "UPDATE pesanan SET status = ? WHERE id = ?", (status_baru, id)
    )
    db.commit()
    return redirect(url_for("admin"))


