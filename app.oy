import os
import sqlite3
from datetime import datetime
from flask import Flask, g, redirect, render_template_string, request, url_for
from werkzeug.utils import secure_filename

app = Flask(__name__)

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DATABASE = os.path.join(BASE_DIR, "geprek_intan.db")
UPLOAD_FOLDER = os.path.join(BASE_DIR, "static", "uploads")
ALLOWED_EXTENSIONS = {"png", "jpg", "jpeg", "gif", "webp"}

app.config["UPLOAD_FOLDER"] = UPLOAD_FOLDER
os.makedirs(UPLOAD_FOLDER, exist_ok=True)


def allowed_file(filename):
    return (
        "." in filename
        and filename.rsplit(".", 1)[1].lower() in ALLOWED_EXTENSIONS
    )


def get_db():
    db = getattr(g, "_database", None)
    if db is None:
        db = g._database = sqlite3.connect(DATABASE)
        db.row_factory = sqlite3.Row
    return db


@app.teardown_appcontext
def close_connection(exception):
    db = getattr(g, "_database", None)
    if db is not None:
        db.close()


def init_db():
    with app.app_context():
        db = get_db()
        db.execute(
            """
            CREATE TABLE IF NOT EXISTS pesanan (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                nama TEXT NOT NULL,
                meja TEXT NOT NULL,
                catatan TEXT,
                rincian TEXT NOT NULL,
                total INTEGER NOT NULL,
                metode_pembayaran TEXT NOT NULL,
                bukti_transfer TEXT,
                status TEXT NOT NULL,
                waktu TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """
        )
        db.commit()


init_db()

# Menggunakan Foto Makanan Asli Berkualitas Tinggi (HD)
MENU = {
    "Nasi Goreng": {
        "harga": 15000,
        "gambar": "https://images.unsplash.com/photo-1603133872878-684f208fb84b?w=200&q=80",
        "deskripsi": "Nasi goreng bumbu rempah gurih + telur ceplok",
    },
    "Ayam Geprek": {
        "harga": 15000,
        "gambar": "https://images.unsplash.com/photo-1626082927389-6cd097cdc6ec?w=200&q=80",
        "deskripsi": "Ayam krispi digeprek sambal pedas + lalapan & nasi",
    },
    "Mie GenZ": {
        "harga": 13000,
        "gambar": "https://images.unsplash.com/photo-1569718212165-3a8278d5f624?w=200&q=80",
        "deskripsi": "Mie pedas kekinian dengan taburan pangsit krispi",
    },
    "Soto Ayam": {
        "harga": 15000,
        "gambar": "https://images.unsplash.com/photo-1547592166-23ac45744acd?w=200&q=80",
        "deskripsi": "Kuah soto kuning segar + suwiran ayam & soun",
    },
    "Es Teh": {
        "harga": 5000,
        "gambar": "https://images.unsplash.com/photo-1556679343-c7306c1976bc?w=200&q=80",
        "deskripsi": "Es teh manis segar pelepas dahaga",
    },
    "Jus Segar": {
        "harga": 5000,
        "gambar": "https://images.unsplash.com/photo-1613478223719-2ab802602423?w=200&q=80",
        "deskripsi": "Jus buah segar racikan harian",
    },
}


@app.route("/", methods=["GET", "POST"])
def index():
    if request.method == "POST":
        nama = request.form.get("nama")
        meja = request.form.get("meja")
        catatan = request.form.get("catatan", "")
        metode_pembayaran = request.form.get("pembayaran")

        pesanan_items = []
        total_harga = 0

        for item, detail in MENU.items():
            qty = request.form.get(f"qty_{item}", 0)
            if qty and int(qty) > 0:
                jumlah = int(qty)
                subtotal = jumlah * detail["harga"]
                total_harga += subtotal
                pesanan_items.append(f"{item} ({jumlah}x) - Rp{subtotal:,}")

        if not pesanan_items:
            return "<script>alert('Pilih minimal 1 menu!'); window.history.back();</script>"

        bukti_filename = None

        if "Transfer Bank" in metode_pembayaran or "QRIS" in metode_pembayaran:
            file_bukti = request.files.get("bukti_transfer")
            if (
                not file_bukti
                or file_bukti.filename == ""
                or not allowed_file(file_bukti.filename)
            ):
                return "<script>alert('❌ Harap unggah foto bukti transfer terlebih dahulu sebelum mengirim pesanan!'); window.history.back();</script>"

            filename = secure_filename(
                f"{datetime.now().strftime('%Y%m%d%H%M%S')}_{file_bukti.filename}"
            )
            file_bukti.save(os.path.join(app.config["UPLOAD_FOLDER"], filename))
            bukti_filename = filename
            status_awal = "Menunggu Verifikasi"
        else:
            status_awal = "Diproses"

        rincian_str = ", ".join(pesanan_items)

        db = get_db()
        db.execute(
            "INSERT INTO pesanan (nama, meja, catatan, rincian, total, metode_pembayaran, bukti_transfer, status) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
            (
                nama,
                meja,
                catatan,
                rincian_str,
                total_harga,
                metode_pembayaran,
                bukti_filename,
                status_awal,
            ),
        )
        db.commit()

        status_badge_color = (
            "#f39c12" if status_awal == "Menunggu Verifikasi" else "#2ecc71"
        )

        return f"""
        <!DOCTYPE html>
        <html>
        <head>
            <meta name="viewport" content="width=device-width, initial-scale=1">
            <title>Struk Pesanan - GEPREK INTAN</title>
            <style>
                body {{ font-family: sans-serif; background: #eef2f5; padding: 15px; color: #333; }}
                .card {{ max-width: 480px; margin: 0 auto; background: white; padding: 20px; border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }}
                h2 {{ text-align: center; color: #d63031; margin-top: 0; }}
                .info {{ background: #f8f9fa; padding: 12px; border-radius: 8px; margin-bottom: 15px; font-size: 14px; line-height: 1.6; }}
                .total {{ font-size: 18px; font-weight: bold; color: #d63031; text-align: right; margin-top: 15px; }}
                .btn {{ display: block; text-align: center; background: #d63031; color: white; text-decoration: none; padding: 12px; border-radius: 8px; font-weight: bold; margin-top: 20px; }}
            </style>
        </head>
        <body>
            <div class="card">
                <h3 style="color:#2ecc71; text-align:center;">✅ Pesanan Berhasil Dikirim!</h3>
                <h2>🍗 GEPREK INTAN</h2>
                <div class="info">
                    <b>Nama Pemesan:</b> {nama}<br>
                    <b>Meja / Alamat:</b> {meja}<br>
                    <b>Metode Pembayaran:</b> {metode_pembayaran}<br>
                    <b>Status Pembayaran:</b> <span style="background:{status_badge_color}; color:white; padding:2px 8px; border-radius:4px; font-weight:bold; font-size:12px;">{status_awal}</span><br>
                    <b>Catatan:</b> {catatan if catatan else '-'}<br><br>
                    <b>Rincian Menu:</b><br>{rincian_str}
                </div>
                <div class="total">Total Bayar: Rp{total_harga:,}</div>
                <a href="/" class="btn">Pesan Pesanan Baru</a>
            </div>
        </body>
        </html>
        """

    menu_html = ""
    for item, detail in MENU.items():
        harga = detail["harga"]
        gambar = detail["gambar"]
        deskripsi = detail["deskripsi"]

        menu_html += f"""
        <div style="display:flex; justify-content:space-between; align-items:center; padding:12px; margin-bottom:12px; background:#fff; border-radius:12px; border:1px solid #ffeaa7; box-shadow:0 2px 5px rgba(0,0,0,0.03);">
            <div style="display:flex; gap:12px; align-items:center; max-width:70%;">
                <img src="{gambar}" alt="{item}" style="width:65px; height:65px; object-fit:cover; border-radius:10px; border: 1px solid #eee;">
                <div>
                    <b style="font-size:15px; color:#2d3436;">{item}</b>
                    <div style="font-size:11px; color:#636e72; margin-top:2px;">{deskripsi}</div>
                    <div style="color:#d63031; font-weight:bold; font-size:14px; margin-top:4px;">Rp {harga:,}</div>
                </div>
            </div>
            <div style="display:flex; align-items:center; gap:6px;">
                <button type="button" onclick="changeQty('{item}', -1)" style="width:30px; height:30px; border-radius:50%; border:none; background:#d63031; color:white; font-weight:bold; cursor:pointer;">-</button>
                <input type="number" id="input_{item}" name="qty_{item}" value="0" min="0" readonly style="width:30px; text-align:center; border:none; background:transparent; font-weight:bold; font-size:15px;">
                <button type="button" onclick="changeQty('{item}', 1)" style="width:30px; height:30px; border-radius:50%; border:none; background:#d63031; color:white; font-weight:bold; cursor:pointer;">+</button>
            </div>
        </div>
        """

    return f"""
    <!DOCTYPE html>
    <html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>GEPREK INTAN - Order</title>
        <style>
            body {{ font-family: sans-serif; background-color: #f8f9fa; margin: 0; padding: 15px; color: #333; }}
            .container {{ max-width: 480px; margin: 0 auto; background: white; padding: 20px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); }}
            .header {{ text-align: center; border-bottom: 2px dashed #ff7675; padding-bottom: 12px; margin-bottom: 20px; }}
            .header h1 {{ color: #d63031; margin: 0; }}
            .form-group {{ margin-top: 15px; }}
            .form-group label {{ font-size: 13px; font-weight: bold; color: #636e72; display: block; margin-bottom: 5px; }}
            .form-group input, .form-group select, .form-group textarea {{ width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 8px; box-sizing: border-box; font-size: 14px; }}
            .btn-order {{ width: 100%; background: #d63031; color: white; border: none; padding: 14px; border-radius: 10px; font-size: 16px; font-weight: bold; margin-top: 20px; cursor: pointer; }}
            .admin-link {{ display: block; text-align: center; margin-top: 15px; color: #636e72; font-size: 13px; text-decoration: none; }}
            .bank-info {{ background:#e3f2fd; border:1px solid #90caf9; padding:12px; border-radius:10px; font-size:12px; margin-top:10px; display:none; }}
        </style>
        <script>
            const menuHarga = {{
                "Nasi Goreng": 15000,
                "Ayam Geprek": 15000,
                "Mie GenZ": 13000,
                "Soto Ayam": 15000,
                "Es Teh": 5000,
                "Jus Segar": 5000
            }};
            function changeQty(item, delta) {{
                const input = document.getElementById('input_' + item);
                let currentVal = parseInt(input.value) || 0;
                currentVal += delta;
                if (currentVal < 0) currentVal = 0;
                input.value = currentVal;
                calculateTotal();
            }}
            function calculateTotal() {{
                let total = 0;
                for (let item in menuHarga) {{
                    const input = document.getElementById('input_' + item);
                    if (input) {{
                        total += (parseInt(input.value) || 0) * menuHarga[item];
                    }}
                }}
                document.getElementById('totalAmount').innerText = 'Rp ' + total.toLocaleString('id-ID');
            }}
            function checkPayment() {{
                const p = document.getElementById('pembayaran').value;
                const bankDiv = document.getElementById('bankInfo');
                const uploadDiv = document.getElementById('uploadArea');
                const fileInput = document.getElementById('buktiFile');

                if (p.includes('Transfer Bank') || p.includes('QRIS')) {{
                    bankDiv.style.display = 'block';
                    uploadDiv.style.display = 'block';
                    fileInput.required = true;
                }} else {{
                    bankDiv.style.display = 'none';
                    uploadDiv.style.display = 'none';
                    fileInput.required = false;
                }}
            }}
        </script>
    </head>
    <body>
        <div class="container">
            <div class="header">
                <h1>🍗 GEPREK INTAN</h1>
                <p>Pilihan Menu Makanan & Minuman Lezat</p>
            </div>
            <form method="POST" enctype="multipart/form-data">
                <h3 style="margin-bottom:15px;">📋 Aneka Menu Makanan & Minuman</h3>
                {menu_html}

                <div class="form-group">
                    <label>Nama Pemesan *</label>
                    <input type="text" name="nama" placeholder="Masukkan nama Anda" required>
                </div>

                <div class="form-group">
                    <label>Nomor Meja / Alamat Pengiriman *</label>
                    <input type="text" name="meja" placeholder="Contoh: Meja 05" required>
                </div>

                <div class="form-group">
                    <label>Metode Pembayaran *</label>
                    <select name="pembayaran" id="pembayaran" onchange="checkPayment()" required>
                        <option value="">-- Pilih Pembayaran --</option>
                        <option value="Tunai di Kasir">💵 Tunai di Kasir</option>
                        <option value="Transfer Bank SeaBank">🏦 Transfer Bank (SeaBank)</option>
                        <option value="QRIS (Digital)">📱 Pembayaran Digital QRIS</option>
                    </select>
                </div>

                <div id="bankInfo" class="bank-info">
                    <b>🏦 Info Rekening SeaBank:</b><br>
                    <b>No Rek:</b> 901398695544 (a/n Nurdin Abas)<br>
                    <i>Transfer sesuai total harga & simpan bukti foto/screenshot transfer.</i>
                </div>

                <div class="form-group" id="uploadArea" style="display:none;">
                    <label>📸 Unggah Foto Bukti Transfer *</label>
                    <input type="file" name="bukti_transfer" id="buktiFile" accept="image/*">
                </div>

                <div class="form-group">
                    <label>Catatan Khusus</label>
                    <textarea name="catatan" rows="2" placeholder="Contoh: Sambal dipisah, Es teh manis"></textarea>
                </div>

                <div style="display:flex; justify-content:space-between; font-size:18px; font-weight:bold; margin-top:20px;">
                    <span>Total Bayar:</span>
                    <span style="color:#d63031;" id="totalAmount">Rp 0</span>
                </div>

                <button type="submit" class="btn-order">🛒 Kirim Pesanan Sekarang</button>
            </form>
            <a href="/admin" class="admin-link">🔒 Masuk ke Halaman Admin</a>
        </div>
    </body>
    </html>
    """


@app.route("/admin")
def admin():
    db = get_db()
    cursor = db.execute("SELECT * FROM pesanan ORDER BY id DESC")
    all_orders = cursor.fetchall()

    rows = ""
    for order in all_orders:
        st = order["status"]
        if st == "Menunggu Verifikasi":
            status_color = "#f39c12"
        elif st == "Diproses":
            status_color = "#e67e22"
        else:
            status_color = "#2ecc71"

        bukti_btn = "-"
        if order["bukti_transfer"]:
            bukti_btn = f'<a href="/static/uploads/{order["bukti_transfer"]}" target="_blank" style="background:#0984e3; color:white; padding:3px 6px; border-radius:4px; text-decoration:none; font-size:10px;">📸 Lihat Bukti</a>'

        rows += f"""
        <tr>
            <td>#{order['id']}</td>
            <td><b>{order['nama']}</b><br><small>{order['meja']}</small></td>
            <td>{order['rincian']}<br><small style="color:#7f8c8d;">Catatan: {order['catatan']}</small></td>
            <td><b>Rp{order['total']:,}</b><br><small>{order['metode_pembayaran']}</small></td>
            <td>{bukti_btn}</td>
            <td><span style="background: {status_color}; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight:bold;">{st}</span></td>
            <td>
                <a href="/admin/status/{order['id']}/Diproses" style="background:#e67e22; color:white; padding:3px 6px; text-decoration:none; border-radius:3px; font-size:10px;">Proses (Acc)</a>
                <a href="/admin/status/{order['id']}/Selesai" style="background:#2ecc71; color:white; padding:3px 6px; text-decoration:none; border-radius:3px; font-size:10px;">Selesai</a>
            </td>
        </tr>
        """

    return f"""
    <!DOCTYPE html>
    <html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Admin - GEPREK INTAN</title>
        <style>
            body {{ font-family: sans-serif; background: #f8f9fa; padding: 15px; color: #333; }}
            .container {{ max-width: 900px; margin: 0 auto; background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); }}
            h2 {{ color: #d63031; margin-top: 0; }}
            table {{ width: 100%; border-collapse: collapse; margin-top: 15px; font-size: 13px; }}
            th, td {{ padding: 10px; text-align: left; border-bottom: 1px solid #eee; }}
            th {{ background: #d63031; color: white; }}
            .back-btn {{ display: inline-block; margin-bottom: 15px; color: #d63031; text-decoration: none; font-weight: bold; }}
        </style>
    </head>
    <body>
        <div class="container">
            <a href="/" class="back-btn">← Kembali ke Halaman Pemesanan</a>
            <h2>🛠️ Admin GEPREK INTAN - Kelola Pesanan</h2>
            <div style="overflow-x:auto;">
                <table>
                    <tr>
                        <th>ID</th>
                        <th>Pemesan</th>
                        <th>Rincian Pesanan</th>
                        <th>Total & Bayar</th>
                        <th>Bukti Transfer</th>
                        <th>Status</th>
                        <th>Aksi Admin</th>
                    </tr>
                    {rows if rows else '<tr><td colspan="7" style="text-align:center;">Belum ada pesanan masuk.</td></tr>'}
                </table>
            </div>
        </div>
    </body>
    </html>
    """


@app.route("/admin/status/<int:id>/<string:status_baru>")
def ubah_status(id, status_baru):
    db = get_db()
    db.execute(
        "UPDATE pesanan SET status = ? WHERE id = ?", (status_baru, id)
    )
    db.commit()
    return redirect(url_for("admin"))


if __name__ == "__main__":
    port = int(os.environ.get("PORT", 5000))
    app.run(debug=False, host="0.0.0.0", port=port)
